# ==============================================================================
# LocalNest Environment Variables Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.local:
#      cp .env.example .env.local
# 2. Fill in the values for your local development setup.
# 3. NEVER commit .env.local or any real secrets/keys to version control.
# 4. In Next.js:
#    - Variables starting with NEXT_PUBLIC_ are exposed to the browser client.
#    - Variables WITHOUT NEXT_PUBLIC_ are strictly server-side only.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration (Client-side & Server-side accessible)
# ------------------------------------------------------------------------------

# Public URL of your Supabase project instance (e.g., https://xyzcompany.supabase.co).
# Scope: Public (accessible in browser client).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anonymous API key (anon key) for Supabase client requests.
# Protected by Supabase Row-Level Security (RLS) policies.
# Scope: Public (accessible in browser client).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ------------------------------------------------------------------------------
# Server-Only Secrets (NEVER prefix with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# The variables below bypass Row Level Security or contain sensitive provider keys.
# They MUST only be accessed in Node.js server routes, Route Handlers, or Server Actions.
# Add/uncomment these when corresponding features are being integrated.

# Supabase Service Role Key (Admin / privileged access, bypasses RLS).
# Scope: Server-only. NEVER expose to the browser!
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay Key ID for payments integration.
# Scope: Server-only (used in backend payment order creation).
# RAZORPAY_KEY_ID=your-razorpay-key-id

# Razorpay Key Secret for signing and validating payment transactions.
# Scope: Server-only. Keep private.
# RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Razorpay Webhook Secret for signature verification on incoming payment webhooks.
# Scope: Server-only.
# RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Firebase Cloud Messaging (FCM) Server Credentials for push notifications.
# Scope: Server-only.
# FCM_SERVER_CREDENTIALS=your-fcm-server-credentials
